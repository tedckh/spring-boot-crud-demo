# PostgreSQL Database Configuration
#
# When running with Docker Compose, the following properties are automatically configured
# from the environment variables set in the docker-compose.yml file.
#
# You can override these values here for local development without Docker.
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/taskdb}
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:user}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:password}

# This setting tells Hibernate to update the database schema on startup.
# For production, you might want to use a more robust solution like Flyway or Liquibase.
spring.jpa.hibernate.ddl-auto=update

# Specify the dialect for PostgreSQL
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect

# Set the JDBC timezone to UTC
spring.jpa.properties.hibernate.jdbc.time_zone=UTC

# Logging Configuration
logging.level.root=INFO
logging.pattern.console=%d{yyyy-MM-dd HH:mm:ss.SSS} %-5p [%t] %-40.40c{1.} : %m%n


# Server Port
# Default to 8080, can be overridden in application.properties
server.port=8080